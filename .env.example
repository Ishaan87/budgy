# --- Supabase project settings (Settings -> API in the Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Newer Supabase projects call this the "publishable key" instead of "anon key" — same value,
# just paste it here under this name regardless of what the dashboard labels it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Database (Settings -> Database -> Connection string -> URI, "Transaction" pooler) ---
# Used by Drizzle for migrations and by API routes for direct queries.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Secrets you generate yourself ---
# 32-byte hex key used to AES-256-GCM encrypt stored LLM API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shared secret Vercel Cron must send as `Authorization: Bearer <value>` to hit /api/cron/*.
# Generate the same way as ENCRYPTION_KEY.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
